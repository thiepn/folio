{
  "name": "folio",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run manifest:release",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "validate:final": "node scripts/validate-final.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:daily": "node scripts/validate-daily-workflow.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "release:verify": "npm run validate:final && npm run validate:release && npm run validate:daily && npm run validate:task-project && npm run validate:planner && npm run validate:reviews-history && npm run validate:habits-focus && npm run validate:command-first && npm run validate:task-v2 && npm run validate:recurrence-v2 && npm run validate:reminders && npm run validate:capture-v2 && npm run validate:organization-v2 && npm run validate:smart-views-v2 && npm run validate:calendar-v2 && npm run validate:kanban-timeline-v2 && npm run validate:d9 && npm run validate:d10 && npm run validate:d11 && npm run validate:d12 && npm run validate:d13 && npm run validate:d14 && npm run validate:d15 && npm run validate:d16 && npm run validate:d17 && npm run validate:d18 && npm run validate:d19 && npm run validate:d20 && npm run build && npm run validate:dist",
    "manifest:release": "node scripts/generate-release-manifest.mjs",
    "validate:task-project": "node scripts/validate-task-project-workflow.mjs",
    "validate:planner": "node scripts/validate-planner-overhaul.mjs",
    "validate:reviews-history": "node scripts/validate-reviews-history.mjs",
    "validate:habits-focus": "node scripts/validate-habits-focus.mjs",
    "validate:command-first": "node scripts/validate-command-first.mjs",
    "validate:task-v2": "node scripts/validate-task-engine-v2.mjs",
    "validate:recurrence-v2": "node scripts/validate-dates-recurrence-v2.mjs",
    "validate:reminders": "node scripts/validate-reminders-notifications.mjs",
    "validate:capture-v2": "node scripts/validate-capture-v2.mjs",
    "validate:organization-v2": "node scripts/validate-organization-v2.mjs",
    "validate:smart-views-v2": "node scripts/validate-smart-views-v2.mjs",
    "validate:calendar-v2": "node scripts/validate-calendar-v2.mjs",
    "validate:kanban-timeline-v2": "node scripts/validate-kanban-timeline-v2.mjs",
    "validate:d9": "node scripts/validate-notes-rich-content-d9.mjs",
    "validate:d10": "node scripts/validate-habits-v2-d10.mjs",
    "validate:d11": "node scripts/validate-focus-time-v2-d11.mjs",
    "validate:d12": "node scripts/validate-analytics-d12.mjs",
    "validate:d13": "node scripts/validate-matrix-countdown-d13.mjs",
    "validate:d14": "node scripts/validate-search-v2-d14.mjs",
    "validate:d15": "node scripts/validate-templates-automation-d15.mjs",
    "validate:d16": "node scripts/validate-collaboration-sharing-d16.mjs",
    "validate:d17": "node scripts/validate-external-integrations-d17.mjs",
    "validate:d18": "node scripts/validate-sync-d18.mjs",
    "validate:d19": "node scripts/validate-full-product-ux-d19.mjs",
    "validate:d20": "node scripts/validate-production-hardening-d20.mjs"
  },
  "dependencies": {
    "dexie": "4.2.0",
    "dexie-react-hooks": "1.1.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "A local-first personal productivity workspace for tasks, projects, planning, habits, focus, and review.",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiepn/folio.git"
  },
  "homepage": "https://thiepn.github.io/folio/",
  "bugs": {
    "url": "https://github.com/thiepn/folio/issues"
  }
}
